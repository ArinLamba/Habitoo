{
  "name": "habitoo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lightningcss": "1.30.1",
    "react-native": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5"
  },
  "scripts": {
    "dev": "npm --workspace apps/web run dev --",
    "dev:web": "npm --workspace apps/web run dev --",
    "dev:mobile": "npm --workspace apps/mobile run start --",
    "mobile:android": "npm --workspace apps/mobile run android --",
    "mobile:ios": "npm --workspace apps/mobile run ios --",
    "mobile:web": "npm --workspace apps/mobile run web --",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm run typecheck:core && npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:core": "npm --workspace packages/core run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
    "db:studio": "npm --workspace apps/web run db:studio",
    "db:push": "npm --workspace apps/web run db:push",
    "db:seed": "npm --workspace apps/web run db:seed",
    "db:reset": "npm --workspace apps/web run db:reset"
  },
  "devDependencies": {
    "@react-native/virtualized-lists": "0.81.5",
    "react-native": "0.81.5",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21"
  }
}
